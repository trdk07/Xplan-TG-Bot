{
  "name": "xplan-discord-verification",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "discord:setup": "node scripts/discord-setup.mjs",
    "check:config": "node scripts/check-config.mjs",
    "test:runtime": "npm run build && node scripts/runtime-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260908.1",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.0",
    "wrangler": "4.129.1",
    "miniflare": "5.20260907.0-alpha"
  }
}
